{
  "agent": "human-review-agent",
  "allowedTools": [
    "get_approval_status",
    "request_human_approval"
  ],
  "callerRoles": [
    "ADMIN",
    "AI_AGENT",
    "CERTIFICATION_ENGINEER",
    "SERVICE"
  ],
  "input": {
    "properties": {
      "action": {
        "anyOf": [
          {
            "enum": [
              "START_EXTERNAL_CERTIFICATION",
              "APPLY_REMEDIATION",
              "ACTIVATE_SESSION_CONFIG"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Action"
      },
      "arguments": {
        "additionalProperties": true,
        "title": "Arguments",
        "type": "object"
      },
      "check_approval_id": {
        "anyOf": [
          {
            "pattern": "^[0-9a-f-]{36}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Check Approval Id"
      },
      "environment": {
        "default": "TEST",
        "enum": [
          "SIMULATOR",
          "TEST",
          "UAT"
        ],
        "title": "Environment",
        "type": "string"
      },
      "evidence_refs": {
        "items": {
          "type": "string"
        },
        "maxItems": 50,
        "title": "Evidence Refs",
        "type": "array"
      },
      "idempotency_key": {
        "anyOf": [
          {
            "pattern": "^[A-Za-z0-9._:-]{8,128}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Idempotency Key"
      },
      "justification": {
        "default": "",
        "maxLength": 4000,
        "title": "Justification",
        "type": "string"
      },
      "requested_by": {
        "anyOf": [
          {
            "pattern": "^[A-Za-z0-9._@-]{1,128}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Requested By"
      },
      "target_id": {
        "anyOf": [
          {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Target Id"
      },
      "target_type": {
        "anyOf": [
          {
            "pattern": "^[a-z0-9-]{2,64}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Target Type"
      }
    },
    "title": "ReviewRequest",
    "type": "object"
  },
  "maxToolCalls": 2,
  "output": {
    "$defs": {
      "ReviewPacket": {
        "properties": {
          "reviewer_checklist": {
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "title": "Reviewer Checklist",
            "type": "array"
          },
          "risks": {
            "items": {
              "type": "string"
            },
            "maxItems": 8,
            "title": "Risks",
            "type": "array"
          },
          "summary": {
            "maxLength": 2000,
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "summary"
        ],
        "title": "ReviewPacket",
        "type": "object"
      }
    },
    "properties": {
      "approval_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Approval Id"
      },
      "expires_at": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Expires At"
      },
      "filed": {
        "title": "Filed",
        "type": "boolean"
      },
      "packet": {
        "anyOf": [
          {
            "$ref": "#/$defs/ReviewPacket"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "payload_hash": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Payload Hash"
      },
      "refusal_reasons": {
        "items": {
          "type": "string"
        },
        "title": "Refusal Reasons",
        "type": "array"
      },
      "risk_level": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Risk Level"
      },
      "status": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Status"
      }
    },
    "required": [
      "filed"
    ],
    "title": "ReviewOutcome",
    "type": "object"
  },
  "promptVersion": "human-review-agent/packet@1",
  "timeoutSeconds": 30,
  "version": "1.0.0"
}
