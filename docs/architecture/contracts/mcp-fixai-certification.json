{
  "server": "fixai-certification",
  "tools": [
    {
      "allowedAgents": null,
      "capability": "READ",
      "description": "Status, verdict and failed scenarios of a run. [capability=READ roles=ADMIN,AI_AGENT,AUDITOR,CERTIFICATION_ENGINEER,SERVICE agents=any agent timeout=15s idempotent=True]",
      "idempotent": true,
      "inputSchema": {
        "properties": {
          "run_id": {
            "pattern": "^[0-9a-f-]{36}$",
            "title": "Run Id",
            "type": "string"
          }
        },
        "required": [
          "run_id"
        ],
        "title": "get_certification_statusArguments",
        "type": "object"
      },
      "name": "get_certification_status",
      "outputSchema": {
        "properties": {
          "evidence_digest": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Digest"
          },
          "failed_scenarios": {
            "items": {
              "type": "string"
            },
            "title": "Failed Scenarios",
            "type": "array"
          },
          "fix_version": {
            "title": "Fix Version",
            "type": "string"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "scenarios_errored": {
            "title": "Scenarios Errored",
            "type": "integer"
          },
          "scenarios_failed": {
            "title": "Scenarios Failed",
            "type": "integer"
          },
          "scenarios_passed": {
            "title": "Scenarios Passed",
            "type": "integer"
          },
          "scenarios_total": {
            "title": "Scenarios Total",
            "type": "integer"
          },
          "simulator_profile": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Simulator Profile"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "target_type": {
            "title": "Target Type",
            "type": "string"
          },
          "verdict": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verdict"
          }
        },
        "required": [
          "run_id",
          "status",
          "verdict",
          "fix_version",
          "target_type",
          "simulator_profile",
          "scenarios_total",
          "scenarios_passed",
          "scenarios_failed",
          "scenarios_errored",
          "evidence_digest"
