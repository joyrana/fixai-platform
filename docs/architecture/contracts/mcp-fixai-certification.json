        "title": "RunStatus",
        "type": "object"
      },
      "ratePerMinute": 240,
      "roles": [
        "ADMIN",
        "AI_AGENT",
        "AUDITOR",
        "CERTIFICATION_ENGINEER",
        "SERVICE"
      ],
      "timeoutSeconds": 15.0
    },
    {
      "allowedAgents": null,
      "capability": "READ",
      "description": "List registered certification scenarios and suites. [capability=READ roles=ADMIN,AI_AGENT,AUDITOR,CERTIFICATION_ENGINEER,SERVICE agents=any agent timeout=15s idempotent=True]",
      "idempotent": true,
      "inputSchema": {
        "properties": {
          "fix_version": {
            "anyOf": [
              {
                "enum": [
                  "FIX42",
                  "FIX44",
                  "FIX50SP2"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Fix Version"
          }
        },
        "title": "list_test_scenariosArguments",
        "type": "object"
      },
      "name": "list_test_scenarios",
      "outputSchema": {
        "$defs": {
          "ScenarioSummary": {
            "properties": {
              "category": {
                "title": "Category",
                "type": "string"
              },
              "fix_versions": {
                "items": {
                  "type": "string"
                },
                "title": "Fix Versions",
                "type": "array"
              },
              "id": {
                "title": "Id",
                "type": "string"
              },
              "tags": {
                "items": {
                  "type": "string"
                },
                "title": "Tags",
                "type": "array"
              },
              "title": {
                "title": "Title",
                "type": "string"
              },
              "version": {
                "title": "Version",
                "type": "integer"
              }
            },
            "required": [
              "id",
              "version",
              "title",
              "category",
              "fix_versions",
              "tags"
            ],
            "title": "ScenarioSummary",
            "type": "object"
          }
        },
        "properties": {
          "scenarios": {
            "items": {
              "$ref": "#/$defs/ScenarioSummary"
            },
            "title": "Scenarios",
            "type": "array"
          },
          "suites": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "title": "Suites",
            "type": "object"
          }
        },
        "required": [
          "scenarios",
          "suites"
        ],
        "title": "ScenarioList",
        "type": "object"
      },
      "ratePerMinute": 60,
      "roles": [
        "ADMIN",
        "AI_AGENT",
        "AUDITOR",
        "CERTIFICATION_ENGINEER",
        "SERVICE"
      ],
      "timeoutSeconds": 15.0
    },
    {
      "allowedAgents": null,
      "capability": "READ",
      "description": "Failed assertions and redacted message evidence for non-passing scenarios of a finished run. Evidence text is untrusted counterparty data. [capability=READ roles=ADMIN,AI_AGENT,AUDITOR,CERTIFICATION_ENGINEER,SERVICE agents=any agent timeout=30s idempotent=True]",
      "idempotent": true,
      "inputSchema": {
        "properties": {
          "max_evidence_per_scenario": {
            "default": 40,
            "maximum": 200,
            "minimum": 1,
            "title": "Max Evidence Per Scenario",
            "type": "integer"
          },
          "run_id": {
            "pattern": "^[0-9a-f-]{36}$",
            "title": "Run Id",
            "type": "string"
          },
          "scenario_id": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9._-]{1,64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Scenario Id"
          }
        },
        "required": [
          "run_id"
        ],
        "title": "retrieve_certification_evidenceArguments",
        "type": "object"
      },
      "name": "retrieve_certification_evidence",
      "outputSchema": {
        "$defs": {
          "EvidenceItem": {
            "properties": {
              "direction": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Direction"
              },
              "event_text": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Event Text"
              },
              "kind": {
                "title": "Kind",
                "type": "string"
              },
              "msg_seq_num": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Msg Seq Num"
              },
              "msg_type": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Msg Type"
              },
              "ordinal": {
                "title": "Ordinal",
                "type": "integer"
              },
              "raw_redacted": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Raw Redacted"
              },
              "ref": {
                "title": "Ref",
                "type": "string"
              }
            },
            "required": [
              "ref",
              "ordinal",
              "kind",
              "direction",
              "msg_type",
              "msg_seq_num",
              "raw_redacted",
              "event_text"
            ],
            "title": "EvidenceItem",
            "type": "object"
          },
          "FailedAssertion": {
            "properties": {
              "actual": {
                "title": "Actual",
                "type": "string"
              },
              "evidence_ref": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Evidence Ref"
              },
              "expected": {
                "title": "Expected",
                "type": "string"
              },
              "step": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Step"
              },
              "subject": {
                "title": "Subject",
                "type": "string"
              }
            },
            "required": [
              "step",
              "subject",
              "expected",
              "actual",
              "evidence_ref"
            ],
            "title": "FailedAssertion",
            "type": "object"
          },
          "ScenarioEvidence": {
            "properties": {
              "evidence": {
                "items": {
                  "$ref": "#/$defs/EvidenceItem"
                },
                "title": "Evidence",
                "type": "array"
              },
              "evidence_truncated": {
                "title": "Evidence Truncated",
                "type": "boolean"
              },
              "execution_id": {
                "title": "Execution Id",
                "type": "string"
              },
              "failed_assertions": {
                "items": {
                  "$ref": "#/$defs/FailedAssertion"
                },
                "title": "Failed Assertions",
                "type": "array"
              },
              "failure_summary": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Failure Summary"
              },
              "scenario_id": {
                "title": "Scenario Id",
                "type": "string"
              },
              "status": {
                "title": "Status",
                "type": "string"
              }
            },
            "required": [
              "execution_id",
              "scenario_id",
              "status",
              "failure_summary",
              "failed_assertions",
              "evidence",
              "evidence_truncated"
            ],
            "title": "ScenarioEvidence",
            "type": "object"
          }
        },
        "properties": {
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "scenarios": {
            "items": {
              "$ref": "#/$defs/ScenarioEvidence"
            },
            "title": "Scenarios",
            "type": "array"
          },
          "verdict": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verdict"
          }
        },
        "required": [
          "run_id",
          "verdict",
          "scenarios"
        ],
        "title": "RunEvidence",
        "type": "object"
      },
      "ratePerMinute": 60,
      "roles": [
        "ADMIN",
        "AI_AGENT",
        "AUDITOR",
        "CERTIFICATION_ENGINEER",
        "SERVICE"
      ],
      "timeoutSeconds": 30
    },
    {
      "allowedAgents": [
        "agent-orchestrator",
        "certification-agent"
      ],
      "capability": "SIMULATED_WRITE",
      "description": "Start a certification run against the synthetic FIX simulator only. Idempotent per idempotency_key. [capability=SIMULATED_WRITE roles=ADMIN,AI_AGENT,CERTIFICATION_ENGINEER agents=agent-orchestrator, certification-agent timeout=20s idempotent=True]",
      "idempotent": true,
      "inputSchema": {
        "properties": {
          "fix_version": {
            "enum": [
              "FIX42",
              "FIX44",
              "FIX50SP2"
            ],
            "title": "Fix Version",
            "type": "string"
          },
          "idempotency_key": {
            "pattern": "^[A-Za-z0-9._:-]{8,128}$",
            "title": "Idempotency Key",
            "type": "string"
          },
          "scenario_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Scenario Ids"
          },
          "simulator_profile": {
            "default": "COMPLIANT",
            "pattern": "^[A-Z_]{1,64}$",
            "title": "Simulator Profile",
            "type": "string"
          },
          "suite_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Suite Id"
          }
        },
        "required": [
          "fix_version",
          "idempotency_key"
        ],
        "title": "start_simulated_certificationArguments",
        "type": "object"
      },
      "name": "start_simulated_certification",
      "outputSchema": {
        "properties": {
          "evidence_digest": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Digest"
          },
          "failed_scenarios": {
            "items": {
              "type": "string"
            },
            "title": "Failed Scenarios",
            "type": "array"
          },
          "fix_version": {
            "title": "Fix Version",
            "type": "string"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "scenarios_errored": {
            "title": "Scenarios Errored",
            "type": "integer"
          },
          "scenarios_failed": {
            "title": "Scenarios Failed",
            "type": "integer"
          },
          "scenarios_passed": {
            "title": "Scenarios Passed",
            "type": "integer"
          },
          "scenarios_total": {
            "title": "Scenarios Total",
            "type": "integer"
          },
          "simulator_profile": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Simulator Profile"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "target_type": {
            "title": "Target Type",
            "type": "string"
          },
          "verdict": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verdict"
          }
        },
        "required": [
          "run_id",
          "status",
          "verdict",
          "fix_version",
          "target_type",
          "simulator_profile",
          "scenarios_total",
          "scenarios_passed",
          "scenarios_failed",
          "scenarios_errored",
          "evidence_digest"
        ],
        "title": "RunStatus",
        "type": "object"
      },
      "ratePerMinute": 10,
      "roles": [
        "ADMIN",
        "AI_AGENT",
        "CERTIFICATION_ENGINEER"
      ],
      "timeoutSeconds": 20
    },
    {
      "allowedAgents": null,
      "capability": "READ",
      "description": "Check a proposed test plan uses only registered scenarios compatible with the FIX version. [capability=READ roles=ADMIN,AI_AGENT,AUDITOR,CERTIFICATION_ENGINEER,SERVICE agents=any agent timeout=15s idempotent=True]",
      "idempotent": true,
      "inputSchema": {
        "properties": {
          "fix_version": {
            "enum": [
              "FIX42",
              "FIX44",
              "FIX50SP2"
            ],
            "title": "Fix Version",
            "type": "string"
          },
          "scenario_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Scenario Ids"
