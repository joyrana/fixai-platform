# Serves the UI and routes /api/<service>/ to each service on the same origin (no CORS needed).
server {
    listen 8080;
    server_tokens off;
    root /usr/share/nginx/html;
    client_max_body_size 1m;

    add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'none'; form-action 'self'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options SAMEORIGIN always;

    proxy_http_version 1.1;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 180s;

    location /api/broker/   { proxy_pass ${BROKER_URL}/; }
    location /api/cert/     { proxy_pass ${CERTIFICATION_URL}/; }
    location /api/workflow/ { proxy_pass ${WORKFLOW_URL}/; }
    location /api/sim/      { proxy_pass ${SIMULATOR_URL}/; }
    location /api/ai/       { proxy_pass ${ORCHESTRATOR_URL}/; }

    location = /healthz { access_log off; return 200 "ok\n"; }
    # `expires` instead of add_header so the server-level security headers are inherited.
    location /assets/ { expires 1y; }
    location / { try_files $uri /index.html; expires -1; }
}
