# Copy to .env for local overrides. Never commit real secrets.
# All values below are local-development defaults for synthetic data only.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fixai
POSTGRES_USER=fixai
POSTGRES_PASSWORD=change-me-local-only

# FIX simulator (synthetic counterparty)
FIX_SIMULATOR_HOST=localhost
FIX_SIMULATOR_PORT=9880

# Security: disabled locally; enable and point at your OIDC issuer for shared environments.
FIXAI_SECURITY_ENABLED=false
FIXAI_OIDC_ISSUER_URI=
FIXAI_OIDC_AUDIENCE=fixai-platform

# AI services. The default provider is deterministic and offline.
FIXAI_LLM_PROVIDER=offline
ANTHROPIC_API_KEY=
FIXAI_LLM_MODEL=claude-sonnet-5-5
