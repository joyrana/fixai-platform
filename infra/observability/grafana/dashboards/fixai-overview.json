{
 "uid": "fixai-overview",
 "title": "FIXAI certification platform",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "tags": [
  "fixai"
 ],
 "panels": [
  {
   "type": "stat",
   "title": "Runs (24h)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "round(sum(increase(fixai_certification_run_duration_seconds_count[24h])))"
    }
   ],
   "id": 1
  },
  {
   "type": "stat",
   "title": "Pass rate (24h)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(fixai_certification_run_duration_seconds_count{verdict=\"PASSED\"}[24h])) / clamp_min(sum(increase(fixai_certification_run_duration_seconds_count[24h])), 1)"
    }
   ],
   "id": 2
  },
  {
   "type": "stat",
   "title": "p95 simulator run time",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(fixai_certification_run_duration_seconds_bucket{target=\"SIMULATOR\"}[1h])))"
    }
   ],
   "id": 3
  },
  {
   "type": "stat",
   "title": "Targets up",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(up) / count(up)"
    }
   ],
   "id": 4
  },
  {
   "type": "timeseries",
   "title": "Certification runs by verdict",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (verdict) (increase(fixai_certification_run_duration_seconds_count[15m]))",
     "legendFormat": "{{verdict}}"
    }
   ],
   "id": 5
  },
  {
   "type": "timeseries",
   "title": "Run duration p50 / p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le, target) (rate(fixai_certification_run_duration_seconds_bucket[15m])))",
     "legendFormat": "p50 {{target}}"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le, target) (rate(fixai_certification_run_duration_seconds_bucket[15m])))",
     "legendFormat": "p95 {{target}}"
    }
   ],
   "id": 6
  },
  {
   "type": "timeseries",
   "title": "Scenario failures by scenario",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (scenario) (increase(fixai_certification_scenario_duration_seconds_count{status!=\"PASSED\"}[1h]))",
     "legendFormat": "{{scenario}}"
    }
   ],
   "id": 7
  },
  {
   "type": "timeseries",
   "title": "HTTP p95 latency by service",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, job, instance) (rate(http_server_requests_seconds_bucket[5m])))",
     "legendFormat": "{{instance}}"
    }
   ],
   "id": 8
  },
  {
   "type": "timeseries",
   "title": "Agent invocations",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (agent, outcome) (rate(fixai_agent_invocations_total[5m]))",
     "legendFormat": "{{agent}} {{outcome}}"
    }
   ],
   "id": 9
  },
  {
   "type": "timeseries",
   "title": "Agent latency p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, agent) (rate(fixai_agent_latency_seconds_bucket[5m])))",
     "legendFormat": "{{agent}}"
    }
   ],
   "id": 10
  },
  {
   "type": "timeseries",
   "title": "LLM fallback rate and injection findings",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (agent) (rate(fixai_agent_llm_fallbacks_total[15m])) / clamp_min(sum by (agent) (rate(fixai_agent_invocations_total[15m])), 1e-9)",
     "legendFormat": "fallback {{agent}}"
    },
    {
     "refId": "B",
     "expr": "sum by (agent) (increase(fixai_agent_injection_findings_total[1h]))",
     "legendFormat": "injection {{agent}}"
    }
   ],
   "id": 11
  },
  {
   "type": "timeseries",
   "title": "LLM tokens and cost",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (agent, direction) (rate(fixai_agent_tokens_total[15m]))",
     "legendFormat": "{{agent}} {{direction}}"
    },
    {
     "refId": "B",
     "expr": "sum(increase(fixai_agent_cost_usd_total[1h]))",
     "legendFormat": "USD / hour"
    }
   ],
   "id": 12
  },
  {
   "type": "timeseries",
   "title": "MCP tool calls by outcome",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 36,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (tool, outcome) (rate(fixai_mcp_tool_calls_total[5m]))",
     "legendFormat": "{{tool}} {{outcome}}"
    }
   ],
   "id": 13
  },
  {
   "type": "timeseries",
   "title": "Workflow outcomes",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 36,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome) (increase(fixai_workflow_outcomes_total[1h]))",
     "legendFormat": "{{outcome}}"
    }
   ],
   "id": 14
  }
 ],
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 }
}
